# Python
__pycache__/
*.py[cod]
*.egg-info/

# Isaac Lab / Hydra / training output
logs/
outputs/
wandb/
runs/

# Local environment/cache
.pytest_cache/
.ruff_cache/
.mypy_cache/
_isaac_sim/

# Stray root-owned duplicate "exported/" dirs left by container runs when
# a run's exported/ subfolder gets flattened into ExportedPolicy/<run>/;
# contents are always identical duplicates of files that already live one
# level up. Undeletable without sudo on the host, so just keep them out of
# git status.
ExportedPolicy/*/exported/
ExportedPolicy/exported/
